# Public browser configuration (the Neon Auth URL is safe to expose).
VITE_NEON_AUTH_URL=

# Canonical app origin used for Stripe Checkout returns.
LMIERE_APP_URL=http://127.0.0.1:3000

# Server-only configuration. Never prefix these with VITE_.
DATABASE_URL=
NEON_AUTH_JWKS_URL=
FAL_KEY=
BLOB_READ_WRITE_TOKEN=

# Transactional email. Verify updates.lmiere.com in Resend before enabling.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
LMIERE_EMAIL_FROM="Lmiere Accounts <accounts@updates.lmiere.com>"
LMIERE_EMAIL_REPLY_TO=support@lmiere.com
LMIERE_FOUNDER_EMAILS=

# Private beta access. Comma-separated; enforced on the server.
LMIERE_ALLOWED_EMAILS=
LMIERE_ADMIN_EMAILS=

# Safety switch: generation requests cannot reach Fal unless this is true.
LMIERE_ENABLE_PAID_GENERATIONS=false

# Each new test account receives its own wallet with this amount.
LMIERE_INITIAL_CREDIT_CENTS=2000

# Hard safety limits during the private beta. Set to 0 only to disable deliberately.
LMIERE_DAILY_USER_LIMIT_CENTS=500
LMIERE_DAILY_GLOBAL_LIMIT_CENTS=2000
LMIERE_MAX_ACTIVE_GENERATIONS=2

# Stripe-hosted prepaid credit checkout. Test mode is locked on by default.
# Prefer a restricted test key once the endpoint permissions are known.
LMIERE_STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
