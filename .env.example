# Public browser configuration (the Neon Auth URL is safe to expose).
VITE_NEON_AUTH_URL=

# Server-only configuration. Never prefix these with VITE_.
DATABASE_URL=
NEON_AUTH_JWKS_URL=
FAL_KEY=
BLOB_READ_WRITE_TOKEN=

# Safety switch: generation requests cannot reach Fal unless this is true.
LMIERE_ENABLE_PAID_GENERATIONS=false

# Each new test account receives its own wallet with this amount.
LMIERE_INITIAL_CREDIT_CENTS=2000
